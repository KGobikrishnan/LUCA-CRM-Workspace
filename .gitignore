# ==============================================================================
# Navi Promo WorkSpace - Git Ignore Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CRITICAL: SENSITIVE DATA, COMPANY SECRETS & DATABASE DUMPS (DO NOT COMMIT!)
# ------------------------------------------------------------------------------
# Production database dumps & backups
*.sql
*.dump
backup.sql
root@*
72.61.*

# Environment configuration files & private keys
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
id_rsa*
*.jks

# Internal credentials & pass files
credentials*
secrets*
*password*

# ------------------------------------------------------------------------------
# 2. BACKEND BUILDS & RUNTIME (Java / Maven / Spring Boot)
# ------------------------------------------------------------------------------
backend/target/
**/target/
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven temporary files
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Logs
logs/
*.log
workspace-backend-access.log
workspace-backend-error.log

# ------------------------------------------------------------------------------
# 3. FRONTEND BUILDS & DEPENDENCIES (Node / React / Vite)
# ------------------------------------------------------------------------------
frontend/node_modules/
**/node_modules/
frontend/dist/
frontend/dist-ssr/
**/dist/
*.local

# npm / yarn / pnpm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
